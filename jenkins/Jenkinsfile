
pipeline {
    agent any

    stages {
        stage('Tests') {
            steps {
                sh 'docker run --rm -v $(pwd):/app -w /app python:3.11-slim pip install -r requirements.txt --break-system-packages -q && python -m pytest tests/ -v'
            }
        }

        stage('Build') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker compose up -d'
            }
        }
    }

    post {
        success {
            echo 'Pipeline succeeded - system updated'
        }
        failure {
            echo 'Pipeline failed - check the logs'
        }
    }
}
